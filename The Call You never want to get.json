  "entity_type": "Nightmare",
  "entity_rank": "Rank 1 — Minor",
  "entity_concept": "Loss of a loved one",
  "entity_virtue": "",
  "entity_vice": "",
  "numina": [
    {
      "name": "Innocuous",
      "desc": "This Numen does not require a roll to activate. Percpetion rolls to notice the entity are penalized by two dice."
    }
  ],
  "manifestations": [
    {
      "name": "Menace",
      "desc": "This area is ripe with potential Nightmare to harvest Essence by enacting its Dread. An appropriate Nightmare may Coalesce here.\n\n**Cause:** A group of people vulnerable to the fear the Night mare embodies, or one person currently very worried about that fear, none of whom believe they can protect themselves from it.\n\n**Ending:** Evacuating endangered civilians, moving the Nightmare to a location without them, or calming them down and convincing them there is a way to protect them selves from the source of fear will remove the Menace Condition. If the Nightmare is Coalesced, removing Menace inflicts the Undermined Nightmare Tilt\n"
    },
    {
      "name": "Coalesce",
      "desc": "This Nightmare assumes a physical form, matter congealing out of the Darkness that underlies our reality. It can move, act, be attacked, and employ all of its Dread Powers and Numina; once embodied, it may also attempt to Possess, Tether, or go Insubstantial. \n\n**Cause:** The Nightmare spent Essence equal to twice its Potency in an area with the appropriate Menace condition. \n\n**Ending:** The Coalesce Condition only ends when the scene ends, or when the Nightmare suffers enough damage to discorporate it. If the Menace condition that it relied on is removed, Coalesce does not end, but the Nightmare suffers the Undermined Nightmare Tilt. "
    },
    {
      "name": "Insubstantial",
      "desc": "This Nightmare is in a Twilight state, becoming intangible while retaining the ability to use Numina and Dread Powers. All rules for creatures in Twilight now apply. \n\n**Cause:** The Nightmare had the Insubstantial Manifestation, which listed a prerequisite, and activated this Manifestation while Coalesced and while the prerequisite was present or true.\n\n**Ending:** Undoing the prerequisite ends this Condition, reverts the Nightmare to Coalesced, and gives it the Undermined Nightmare Tilt."
    },
    {
      "name": "Possess",
      "desc": ""
    },
    {
      "name": "Tether",
      "desc": "This Nightmare is keyed to a specific individual, using it as an anchoring point, similar to Fetter; effects that require Fetter may also use Tether. It Tethers itself to an individual, but may move away from that person and use Dread Powers on anything. As long as its Tether is more concerned about the Nightmare than anything else, the Nightmare can remain Tethered indefinitely and send Essence back to the Nightscape remotely.\n\n**Cause:** The Nightmare had the Tether Manifestation, which listed a prerequisite, and activated this Manifestation on someone who matched the prerequisite.\n\n**Ending:** Undoing the prerequisite ends this Condition, reverts the Nightmare to Coalesced, and gives it the Undermined Nightmare Tilt"
    }
  ],
  "influences": [
    {
      "name": "Grief",
      "rating": 1,
      "desc": ""
    }
  ],
  "entity_ban": "Cannot use the death of people already known to have passed.",
  "entity_bane": "Any proof or direct presence of the person the Nightmare is currently implying to be dead.",
  "anchors": [],
  "horror_type": "",
  "horror_concept": "",
  "potency": 1,
  "dread_powers": [
    {
      "name": "Know Soul",
      "desc": "The creature can see into the depths of its victim's soul. By spending 1 Essence, it automatically learns the victim's Virtue/Drive, Vice/Dread, Aspirations/Oaths, and current Integrity/Inner Light. By spending an additional Essence point, it learns the circumstances of the character's most recent failed breaking point. Subsequent Willpower points reveal older breaking points. If the creature uses its knowledge against the victim, it earns an exceptional success on a roll of three successes or more."
    },
    {
      "name": "Madness and Terror",
      "desc": "The monster's gaze (or perhaps its voice, touch, or toxic blood) induces madness and terror in its victims. By expending 1 Essence and making a roll of an appropriate dice pool contested by the victim's Composure, the Nightmare may inflict one of the following Conditions on the Victim: Guilty, Shaken, or Spooked. For 3 Willpower it may instead inflict the Broken, Fugue, or Madness Conditions."
    }
  ],
